    "driving_licence":   { "id": "driving_licence",   "label": "Driving Licence",  "sides": 2, "notes": "Front and back required." },
    "residence_permit":  { "id": "residence_permit",  "label": "Residence Permit", "sides": 2, "notes": "Front and back required." }
  },
  "byCountry": {
