    "ES":      ["passport", "national_id", "residence_permit"],
    "IT":      ["passport", "national_id", "residence_permit"],
    "NL":      ["passport", "national_id", "residence_permit"],
    "SE":      ["passport", "national_id", "residence_permit"],
    "PL":      ["passport", "national_id", "residence_permit"],
    "CH":      ["passport", "national_id", "residence_permit"],
    "NO":      ["passport", "national_id", "residence_permit"],
    "US":      ["passport", "driving_licence"],
    "CA":      ["passport", "driving_licence"],
    "AU":      ["passport", "driving_licence"],
    "NZ":      ["passport", "driving_licence"],
    "SG":      ["passport", "national_id"],
    "HK":      ["passport", "national_id"],
    "JP":      ["passport", "national_id"],
    "ZA":      ["passport", "national_id"],
    "IN":      ["passport"],
    "AE":      ["passport"]
  }
